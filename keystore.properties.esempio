# Copia questo file in `keystore.properties`, nella stessa cartella, e riempilo
# con i valori della chiave di rilascio. Quel file è ignorato da git, questo no:
# serve a dire quali valori esistono senza rivelarne nessuno.
#
# Senza `keystore.properties` il progetto si compila lo stesso, anche in
# rilascio: l'APK esce firmato con la chiave di debug, che va bene per provarlo
# e non va bene per distribuirlo. La pipeline di rilascio se ne accorge e si
# ferma.
#
# `storeFile` vuole un percorso assoluto. La chiave non sta dentro il
# repository, quindi un percorso relativo direbbe qualcosa di diverso a
# seconda di dove si è.

storeFile=C:/Users/<utente>/.chiavi-portfolio/portfolio.jks
storePassword=
keyAlias=portfolio
keyPassword=
